  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to use this dashboard",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Filter with the variables above (service, topic, operation) or type directly in the query, e.g. `{compose_project=\"user-service\"} |= \"user_id=109\"` to follow one user's CDC processing.\n\nClick a log line's **TraceID** link (when present) to jump straight into Tempo. From a trace in Tempo, use **Logs for this span** to jump back here."
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Monolith",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{compose_project=\"monolito-microservice\", container=~\".*backend.*\"}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      }
