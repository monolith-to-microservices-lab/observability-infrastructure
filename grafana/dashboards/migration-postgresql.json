  "templating": {
    "list": [
      {
        "name": "database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(pg_up, job)",
        "refresh": 2,
        "label": "Database",
        "multi": false,
        "includeAll": false,
        "sort": 1
      }
    ]
