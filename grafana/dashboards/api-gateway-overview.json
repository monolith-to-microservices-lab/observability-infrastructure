        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{compose_project=\"api-gateway\", service=\"api-gateway\"} |= \"\\\"log_type\\\":\\\"access\\\"\" | json | line_format \"{{.method}} {{.path}} [{{.route}} -> {{.upstream}}] {{.status}} {{.latencies_request}}ms (upstream {{.latencies_proxy}}ms) request_id={{.request_id}}\"",
