    {
      "id": 3,
      "type": "stat",
      "title": "Requests/s",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(kong_http_requests_total[1m]))",
          "refId": "A",
