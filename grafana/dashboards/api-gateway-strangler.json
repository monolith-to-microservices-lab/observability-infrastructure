      "type": "timeseries",
      "title": "Responses/s by route and destination, per status class",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (route, service, class) (label_replace(rate(kong_http_requests_total{service!=\"\"}[1m]), \"class\", \"${1}xx\", \"code\", \"([0-9])..\") )",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{route}} -> {{service}} {{class}}"
        }
      ],
      "fieldConfig": {
