# Lab-only defaults - these mirror the placeholder credentials already used by
# the other repos in this lab (monolito-microservice, user-service,
# sales-service). None of this is a real secret; do not reuse these values
# outside this local lab.

# --- Postgres exporters (must match each service's own docker-compose.yml) ---
LEGACY_PG_USER=postgres
LEGACY_PG_PASSWORD=postgres
LEGACY_PG_DB=monolith

USER_PG_USER=user_service
USER_PG_PASSWORD=user_service
USER_PG_DB=user_service

SALES_PG_USER=sales
SALES_PG_PASSWORD=sales
SALES_PG_DB=sales

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
